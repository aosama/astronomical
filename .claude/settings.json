{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config --worktree core.hooksPath .githooks 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Wiring the repository git hooks"
          }
        ]
      }
    ]
  }
}
