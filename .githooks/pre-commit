#!/usr/bin/env sh

set -eu

REPOSITORY_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    printf '%s\n' '[pre-commit] status=failed reason=not-a-git-worktree' >&2
    exit 1
}

# Identity first: it is instant, and a commit carrying a personal email is
# public forever once pushed, so it must not wait behind slower checks.
printf '%s\n' "[pre-commit] status=start check=commit-identity root=${REPOSITORY_ROOT}"
if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- commit-identity --staged; then
    printf '%s\n' "[pre-commit] status=success check=commit-identity"
else
    printf '%s\n' "[pre-commit] status=failed check=commit-identity" >&2
    exit 1
fi

printf '%s\n' "[pre-commit] status=start check=staged-source-size root=${REPOSITORY_ROOT}"
started_epoch_seconds="$(date +%s)"
# The manifest path pins the build to this checkout's xtask while the
# source-size staged scan itself follows the invoking repository, so the hook
# stays faithful in worktrees and other checkouts.
if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- source-size --staged; then
    elapsed_seconds=$(( $(date +%s) - started_epoch_seconds ))
    printf '%s\n' "[pre-commit] status=success check=staged-source-size elapsed_seconds=${elapsed_seconds}"
else
    elapsed_seconds=$(( $(date +%s) - started_epoch_seconds ))
    printf '%s\n' "[pre-commit] status=failed check=staged-source-size elapsed_seconds=${elapsed_seconds}" >&2
    exit 1
fi

# cargo-crap complexity ratchet: HARD FAIL. The Linux config-contracts lane
# repeats it against the base commit as a backstop, since hooks can fail to
# run without a word (a hooks path naming a missing folder). Scores every
# function against the baseline committed at HEAD without compiling the
# workspace, through `cargo xtask crap-baseline`: an existing function may
# only improve, growth fails the commit, and a function the baseline does
# not list yet may not exceed cyclomatic complexity 15 unless
# crap-admissions.json names it. The gate also runs when only the baseline,
# the admissions or the cargo-crap configuration change. A missing cargo-crap
# is a hard failure too: install it with
# `brew install cargo-binstall && cargo binstall cargo-crap`.
if git diff --cached --name-only | grep -Eq '\.rs$|^crap-baseline\.json$|^crap-admissions\.json$|^\.cargo-crap\.toml$'; then
    printf '%s\n' "[pre-commit] status=start check=crap-complexity-ratchet root=${REPOSITORY_ROOT}"
    gate_started_epoch_seconds="$(date +%s)"
    if ! command -v cargo-crap >/dev/null 2>&1; then
        gate_elapsed_seconds=$(( $(date +%s) - gate_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=crap-complexity-ratchet elapsed_seconds=${gate_elapsed_seconds}" >&2
        printf '%s\n' '[pre-commit] hint=cargo-crap is required (this hook is the sole complexity gate): brew install cargo-binstall && cargo binstall cargo-crap' >&2
        exit 1
    fi
    if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- crap-baseline; then
        gate_elapsed_seconds=$(( $(date +%s) - gate_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=success check=crap-complexity-ratchet elapsed_seconds=${gate_elapsed_seconds}"
    else
        gate_elapsed_seconds=$(( $(date +%s) - gate_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=crap-complexity-ratchet elapsed_seconds=${gate_elapsed_seconds}" >&2
        printf '%s\n' '[pre-commit] hint=each violation line above names its own remedy' >&2
        exit 1
    fi
fi

# Duplication ratchet (issue #2473): HARD FAIL, in the hooks and on the
# config-contracts lane, like the complexity ratchet above.
# `cargo xtask check-duplication` counts the code lines that sit in a block
# of six or more lines repeated in another file, production and test code
# apart, and fails when either count exceeds the baseline committed at HEAD. It needs no tool beyond xtask and
# takes about three seconds, so it runs whenever Rust source or the baseline
# is staged.
if git diff --cached --name-only | grep -Eq '\.rs$|^duplication-baseline\.json$'; then
    printf '%s\n' "[pre-commit] status=start check=duplication-ratchet root=${REPOSITORY_ROOT}"
    duplication_started_epoch_seconds="$(date +%s)"
    if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- check-duplication --top 5; then
        duplication_elapsed_seconds=$(( $(date +%s) - duplication_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=success check=duplication-ratchet elapsed_seconds=${duplication_elapsed_seconds}"
    else
        duplication_elapsed_seconds=$(( $(date +%s) - duplication_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=duplication-ratchet elapsed_seconds=${duplication_elapsed_seconds}" >&2
        printf '%s\n' '[pre-commit] hint=move the repeated block into one shared place; the file pairs above show where it is' >&2
        exit 1
    fi
fi

# Metal kernel check (issue #2712): HARD FAIL. Every kernel lives in a
# .metal file named by its scope, none is declared from Rust text, and every
# kernel compiles offline exactly as MLX wraps it, for every instantiation
# and every way MLX may pass its inputs. Sources that compiled before are
# remembered by digest, so an unchanged tree takes about a second. It needs
# the patched MLX sources (`cargo xtask provision-bindgen-headers`) and the
# Metal toolchain.
if git diff --cached --name-only | grep -Eq '\.rs$|\.metal$|\.h$'; then
    printf '%s\n' "[pre-commit] status=start check=metal-kernels root=${REPOSITORY_ROOT}"
    metal_started_epoch_seconds="$(date +%s)"
    if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- check-metal-kernels; then
        metal_elapsed_seconds=$(( $(date +%s) - metal_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=success check=metal-kernels elapsed_seconds=${metal_elapsed_seconds}"
    else
        metal_elapsed_seconds=$(( $(date +%s) - metal_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=metal-kernels elapsed_seconds=${metal_elapsed_seconds}" >&2
        printf '%s\n' '[pre-commit] hint=each line above names the kernel file and what to fix' >&2
        exit 1
    fi
fi

# The clippy pass below only matters when Rust source changed, so a commit
# touching only the baseline, the admissions or .cargo-crap.toml skips it.
if git diff --cached --name-only | grep -q '\.rs$'; then
    # The 80-code-line budget (clippy.toml, issue #1637; AGENTS.md sets the
    # limit for production and test code alike) — enforced HERE and only
    # here: no clippy runs in GitHub Actions. The workspace lints tables
    # deny clippy::too_many_lines, so this single default-world pass fails
    # when any function crosses the budget.
    # The pass is `cargo xtask function-length-budget`. It first refuses any
    # allow or expect of clippy::too_many_lines in any Rust source, which
    # would let a long function through; then, on macOS, exactly
    # `cargo clippy --workspace --all-targets`; on other hosts it leaves out
    # the crates whose manifest declares macOS-only host platforms, and
    # their dependents, which cannot build there.
    # Default world only: the pass is incremental over warm Cargo build outputs so commits
    # stay fast. Feature-gated acceptance tests get their own pass below;
    # every other feature-gated path stays linted by the developer's own
    # lane runs.
    printf '%s\n' "[pre-commit] status=start check=function-length-budget root=${REPOSITORY_ROOT}"
    budget_started_epoch_seconds="$(date +%s)"
    if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- function-length-budget; then
        budget_elapsed_seconds=$(( $(date +%s) - budget_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=success check=function-length-budget elapsed_seconds=${budget_elapsed_seconds}"
    else
        budget_elapsed_seconds=$(( $(date +%s) - budget_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=function-length-budget elapsed_seconds=${budget_elapsed_seconds}" >&2
        printf '%s\n' '[pre-commit] hint=a function crossed the 80-line budget, or code exempted itself with an allow or expect of clippy::too_many_lines — split the function into named steps and drop the attribute' >&2
        exit 1
    fi
fi

# Model-serving and the crates split out of it (issue #2340) on their
# own, default features (issue #1719). The workspace pass above unifies
# features, which switches direct-mlx on for both and hides dead code that
# only the direct-MLX engines use; that drift once broke the plain
# `cargo test -p model-serving` lane. Gated on staged paths of
# either crate so other commits never pay the second feature world.
if git diff --cached --name-only | grep -Eq '^crates/(model-serving|model-primitives|speech|artifact-validation|image-generation|engine-core|qwen35|qwen35-quantization-probe|decision-models)/'; then
    printf '%s\n' "[pre-commit] status=start check=model-serving-default-features root=${REPOSITORY_ROOT}"
    default_features_started_epoch_seconds="$(date +%s)"
    # `cargo xtask model-serving-default-features` lints the crates in their
    # default world and the quantization probe in its own call; on hosts other
    # than macOS it leaves out the crates that host cannot build.
    if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- model-serving-default-features; then
        default_features_elapsed_seconds=$(( $(date +%s) - default_features_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=success check=model-serving-default-features elapsed_seconds=${default_features_elapsed_seconds}"
    else
        default_features_elapsed_seconds=$(( $(date +%s) - default_features_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=model-serving-default-features elapsed_seconds=${default_features_elapsed_seconds}" >&2
        printf '%s\n' '[pre-commit] hint=code used only with direct-mlx must carry that feature gate (or any(test, feature = "direct-mlx") for pure units with unit tests)' >&2
        exit 1
    fi
fi

# Acceptance tests with every feature on (`cargo xtask
# lint-acceptance-features`, whose module comment records why and what it
# costs). Their journeys sit behind features, so the default-world pass above
# never type-checks them and no GitHub Actions lane compiles the crate.
# Gated on any staged Rust source, not on acceptance paths, because the
# breaks it guards against came from crates the acceptance tests only
# consume (issues #2052 and #2076). Feature-gated acceptance code is thereby
# held to the same 80-line function budget as the default world.
if git diff --cached --name-only | grep -q '\.rs$'; then
    printf '%s\n' "[pre-commit] status=start check=acceptance-all-features root=${REPOSITORY_ROOT}"
    acceptance_started_epoch_seconds="$(date +%s)"
    if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- lint-acceptance-features; then
        acceptance_elapsed_seconds=$(( $(date +%s) - acceptance_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=success check=acceptance-all-features elapsed_seconds=${acceptance_elapsed_seconds}"
    else
        acceptance_elapsed_seconds=$(( $(date +%s) - acceptance_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=acceptance-all-features elapsed_seconds=${acceptance_elapsed_seconds}" >&2
        exit 1
    fi
fi

# Coverage floor for the memory-policy crate (local hook only; deliberately
# no continuous-integration step). The crate is the admission and eviction
# brain, so any commit staging changes to its sources — deletions included,
# since removing a well-covered file can pull the aggregate below the floor —
# must keep cargo-llvm-cov line coverage at or above 90%. Gated on staged
# paths so unrelated commits never pay the instrumented coverage run.
if git diff --cached --name-only | grep -q '^crates/foundation/memory-policy/'; then
    printf '%s\n' "[pre-commit] status=start check=memory-policy-coverage-floor root=${REPOSITORY_ROOT}"
    coverage_started_epoch_seconds="$(date +%s)"
    if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- coverage-floor; then
        coverage_elapsed_seconds=$(( $(date +%s) - coverage_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=success check=memory-policy-coverage-floor elapsed_seconds=${coverage_elapsed_seconds}"
    else
        coverage_elapsed_seconds=$(( $(date +%s) - coverage_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=memory-policy-coverage-floor elapsed_seconds=${coverage_elapsed_seconds}" >&2
        exit 1
    fi
fi
