#!/usr/bin/env sh

set -eu

REPOSITORY_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    printf '%s\n' '[pre-commit] status=failed reason=not-a-git-worktree' >&2
    exit 1
}

# Identity first: it is instant, and a commit carrying a personal email is
# public forever once pushed, so it must not wait behind slower checks.
printf '%s\n' "[pre-commit] status=start check=commit-identity root=${REPOSITORY_ROOT}"
if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- commit-identity --staged; then
    printf '%s\n' "[pre-commit] status=success check=commit-identity"
else
    printf '%s\n' "[pre-commit] status=failed check=commit-identity" >&2
    exit 1
fi

printf '%s\n' "[pre-commit] status=start check=staged-source-size root=${REPOSITORY_ROOT}"
started_epoch_seconds="$(date +%s)"
# The manifest path pins the build to this checkout's xtask while the
# source-size staged scan itself follows the invoking repository, so the hook
# stays faithful in worktrees and other checkouts.
if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- source-size --staged; then
    elapsed_seconds=$(( $(date +%s) - started_epoch_seconds ))
    printf '%s\n' "[pre-commit] status=success check=staged-source-size elapsed_seconds=${elapsed_seconds}"
else
    elapsed_seconds=$(( $(date +%s) - started_epoch_seconds ))
    printf '%s\n' "[pre-commit] status=failed check=staged-source-size elapsed_seconds=${elapsed_seconds}" >&2
    exit 1
fi

# cargo-crap complexity ratchet: HARD FAIL, pre-commit ONLY (policy,
# 2026-10-31 — CI runs no code-shape enforcement at all). Scores every
# function against the baseline committed at HEAD without compiling the
# workspace, through `cargo xtask crap-baseline`: an existing function may
# only improve, growth fails the commit, and a function the baseline does
# not list yet may not exceed cyclomatic complexity 15 unless
# crap-admissions.json names it. The gate also runs when only the baseline,
# the admissions or the cargo-crap configuration change. A missing cargo-crap
# is a hard failure too: install it with
# `brew install cargo-binstall && cargo binstall cargo-crap`.
if git diff --cached --name-only | grep -Eq '\.rs$|^crap-baseline\.json$|^crap-admissions\.json$|^\.cargo-crap\.toml$'; then
    printf '%s\n' "[pre-commit] status=start check=crap-complexity-ratchet root=${REPOSITORY_ROOT}"
    gate_started_epoch_seconds="$(date +%s)"
    if ! command -v cargo-crap >/dev/null 2>&1; then
        gate_elapsed_seconds=$(( $(date +%s) - gate_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=crap-complexity-ratchet elapsed_seconds=${gate_elapsed_seconds}" >&2
        printf '%s\n' '[pre-commit] hint=cargo-crap is required (this hook is the sole complexity gate): brew install cargo-binstall && cargo binstall cargo-crap' >&2
        exit 1
    fi
    if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- crap-baseline; then
        gate_elapsed_seconds=$(( $(date +%s) - gate_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=success check=crap-complexity-ratchet elapsed_seconds=${gate_elapsed_seconds}"
    else
        gate_elapsed_seconds=$(( $(date +%s) - gate_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=crap-complexity-ratchet elapsed_seconds=${gate_elapsed_seconds}" >&2
        printf '%s\n' '[pre-commit] hint=each violation line above names its own remedy' >&2
        exit 1
    fi
fi

# The clippy pass below only matters when Rust source changed, so a commit
# touching only the baseline, the admissions or .cargo-crap.toml skips it.
if git diff --cached --name-only | grep -q '\.rs$'; then
    # The 100-code-line budget (clippy.toml, issue #1637) — enforced HERE
    # and only here: no clippy runs in GitHub Actions. The workspace lints
    # tables deny clippy::too_many_lines, and the 68 pre-existing
    # over-budget functions carry #[expect], so this single default-world
    # pass fails when a function crosses the budget without an expect, and
    # an #[expect] self-cleans when its function shrinks below the budget.
    # Default world only: the pass is warm-cache incremental so commits
    # stay fast, and feature-gated code stays linted by the developer's
    # own lane runs.
    printf '%s\n' "[pre-commit] status=start check=function-length-budget root=${REPOSITORY_ROOT}"
    budget_started_epoch_seconds="$(date +%s)"
    if cargo clippy --workspace --all-targets; then
        budget_elapsed_seconds=$(( $(date +%s) - budget_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=success check=function-length-budget elapsed_seconds=${budget_elapsed_seconds}"
    else
        budget_elapsed_seconds=$(( $(date +%s) - budget_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=function-length-budget elapsed_seconds=${budget_elapsed_seconds}" >&2
        printf '%s\n' '[pre-commit] hint=a function crossed the 100-line budget, or an #[expect] became unfulfilled after a function shrank — fix the function or drop the expect' >&2
        exit 1
    fi
fi

# Model-serving on its own, default features (issue #1719). The workspace
# pass above unifies features, which switches direct-mlx on for
# model-serving and hides dead code that only the direct-MLX engines use;
# that drift once broke the plain `cargo test -p astronomical-model-serving`
# lane. Gated on staged model-serving paths so other commits never pay the
# second feature world.
if git diff --cached --name-only | grep -q '^crates/model-serving/'; then
    printf '%s\n' "[pre-commit] status=start check=model-serving-default-features root=${REPOSITORY_ROOT}"
    default_features_started_epoch_seconds="$(date +%s)"
    if cargo clippy -p astronomical-model-serving --all-targets; then
        default_features_elapsed_seconds=$(( $(date +%s) - default_features_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=success check=model-serving-default-features elapsed_seconds=${default_features_elapsed_seconds}"
    else
        default_features_elapsed_seconds=$(( $(date +%s) - default_features_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=model-serving-default-features elapsed_seconds=${default_features_elapsed_seconds}" >&2
        printf '%s\n' '[pre-commit] hint=code used only with direct-mlx must carry that feature gate (or any(test, feature = "direct-mlx") for pure units with unit tests)' >&2
        exit 1
    fi
fi

# Acceptance tests with every feature on. Their journeys sit behind features
# (serving-acceptance, direct-mlx, performance-measurement and others), so
# the default-world pass above never type-checks them, and no GitHub Actions
# lane compiles this crate: its journeys need an Apple-silicon graphics
# processor and installed models. A change elsewhere, such as a new worker
# event, therefore broke them unseen twice (issues #2052 and #2076). Gated on
# any staged Rust source, not on acceptance paths, because both breaks came
# from crates the acceptance tests only consume. Measured on a warm cache:
# under one second with nothing to recheck, two seconds after an edit to a
# crate the tests depend on.
if git diff --cached --name-only | grep -q '\.rs$'; then
    printf '%s\n' "[pre-commit] status=start check=acceptance-all-features root=${REPOSITORY_ROOT}"
    acceptance_started_epoch_seconds="$(date +%s)"
    if cargo clippy -p astronomical-acceptance --tests --all-features; then
        acceptance_elapsed_seconds=$(( $(date +%s) - acceptance_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=success check=acceptance-all-features elapsed_seconds=${acceptance_elapsed_seconds}"
    else
        acceptance_elapsed_seconds=$(( $(date +%s) - acceptance_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=acceptance-all-features elapsed_seconds=${acceptance_elapsed_seconds}" >&2
        printf '%s\n' '[pre-commit] hint=a feature-gated acceptance test no longer compiles; the staged change may be in a crate it uses rather than in the test itself' >&2
        exit 1
    fi
fi

# Coverage floor for the memory-policy crate (local hook only; deliberately
# no continuous-integration step). The crate is the admission and eviction
# brain, so any commit staging changes to its sources — deletions included,
# since removing a well-covered file can pull the aggregate below the floor —
# must keep cargo-llvm-cov line coverage at or above 90%. Gated on staged
# paths so unrelated commits never pay the instrumented coverage run.
if git diff --cached --name-only | grep -q '^crates/astronomical-memory-policy/'; then
    printf '%s\n' "[pre-commit] status=start check=memory-policy-coverage-floor root=${REPOSITORY_ROOT}"
    coverage_started_epoch_seconds="$(date +%s)"
    if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- coverage-floor; then
        coverage_elapsed_seconds=$(( $(date +%s) - coverage_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=success check=memory-policy-coverage-floor elapsed_seconds=${coverage_elapsed_seconds}"
    else
        coverage_elapsed_seconds=$(( $(date +%s) - coverage_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=memory-policy-coverage-floor elapsed_seconds=${coverage_elapsed_seconds}" >&2
        exit 1
    fi
fi
