#!/usr/bin/env sh

set -eu

REPOSITORY_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    printf '%s\n' '[pre-commit] status=failed reason=not-a-git-worktree' >&2
    exit 1
}

printf '%s\n' "[pre-commit] status=start check=staged-source-size root=${REPOSITORY_ROOT}"
started_epoch_seconds="$(date +%s)"
# The manifest path pins the build to this checkout's xtask while the
# source-size staged scan itself follows the invoking repository, so the hook
# stays faithful in worktrees and other checkouts.
if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- source-size --staged; then
    elapsed_seconds=$(( $(date +%s) - started_epoch_seconds ))
    printf '%s\n' "[pre-commit] status=success check=staged-source-size elapsed_seconds=${elapsed_seconds}"
else
    elapsed_seconds=$(( $(date +%s) - started_epoch_seconds ))
    printf '%s\n' "[pre-commit] status=failed check=staged-source-size elapsed_seconds=${elapsed_seconds}" >&2
    exit 1
fi

# Function-length budget gate (issue #1637): clippy::too_many_lines is
# denied through the workspace lints tables, and every pre-existing
# over-budget function carries #[expect] so the debt is tracked and
# self-cleaning. A commit staging Rust sources re-proves the budget in the
# default and MLX worlds; the acceptance superset worlds are CI-owned.
if git diff --cached --name-only | grep -q '\.rs$'; then
    printf '%s\n' "[pre-commit] status=start check=function-length-budget root=${REPOSITORY_ROOT}"
    budget_started_epoch_seconds="$(date +%s)"
    if cargo clippy --workspace --all-targets && cargo clippy --workspace --all-targets --features astronomical-model-serving/direct-mlx,astronomical-runtime-integration/mlx,astronomical-jangtq2-qwen35/direct-mlx,astronomical-quantization/direct-mlx,astronomical-acceptance/direct-mlx; then
        budget_elapsed_seconds=$(( $(date +%s) - budget_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=success check=function-length-budget elapsed_seconds=${budget_elapsed_seconds}"
    else
        budget_elapsed_seconds=$(( $(date +%s) - budget_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=function-length-budget elapsed_seconds=${budget_elapsed_seconds}" >&2
        printf '%s\n' '[pre-commit] hint=a function crossed the 100-line budget, or an #[expect] became unfulfilled after a function shrank — fix the function or drop the expect' >&2
        exit 1
    fi

    # Hard function-length gate (issue #1637): the budget check above fails
    # untracked over-budget functions, but a suppression attribute silences it
    # — which is how tracked debt is carried. This gate force-warns the budget
    # lint, overriding every #[expect]/#[allow]. --fail-on-production fails
    # when any production function exceeds 100 code lines unless it is one of
    # the explicit Family D exemptions in the xtask gate source.
    # --fail-on-tests freezes test-scope debt: a known site must not grow past
    # its frozen code-line count, and any test site the freeze list does not
    # name is new debt and fails the commit. Same lane policy as the budget
    # check: default and MLX worlds locally, the acceptance feature superset
    # stays CI-owned.
    printf '%s\n' "[pre-commit] status=start check=function-length-budget-gate root=${REPOSITORY_ROOT}"
    gate_started_epoch_seconds="$(date +%s)"
    if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- function-length --fail-on-production --fail-on-tests --lanes default-world,mlx-world; then
        gate_elapsed_seconds=$(( $(date +%s) - gate_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=success check=function-length-budget-gate elapsed_seconds=${gate_elapsed_seconds}"
    else
        gate_elapsed_seconds=$(( $(date +%s) - gate_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=function-length-budget-gate elapsed_seconds=${gate_elapsed_seconds}" >&2
        printf '%s\n' '[pre-commit] hint=a function crossed the budget even with its suppression attribute — production: split it or record an accepting decision on issue #1637 before adding an exemption; tests: split it or record a freeze decision on issue #1637' >&2
        exit 1
    fi
fi

# Coverage floor for the memory-policy crate (local hook only; deliberately
# no continuous-integration step). The crate is the admission and eviction
# brain, so any commit staging changes to its sources — deletions included,
# since removing a well-covered file can pull the aggregate below the floor —
# must keep cargo-llvm-cov line coverage at or above 90%. Gated on staged
# paths so unrelated commits never pay the instrumented coverage run.
if git diff --cached --name-only | grep -q '^crates/astronomical-memory-policy/'; then
    printf '%s\n' "[pre-commit] status=start check=memory-policy-coverage-floor root=${REPOSITORY_ROOT}"
    coverage_started_epoch_seconds="$(date +%s)"
    if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- coverage-floor; then
        coverage_elapsed_seconds=$(( $(date +%s) - coverage_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=success check=memory-policy-coverage-floor elapsed_seconds=${coverage_elapsed_seconds}"
    else
        coverage_elapsed_seconds=$(( $(date +%s) - coverage_started_epoch_seconds ))
        printf '%s\n' "[pre-commit] status=failed check=memory-policy-coverage-floor elapsed_seconds=${coverage_elapsed_seconds}" >&2
        exit 1
    fi
fi
