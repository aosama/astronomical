#!/usr/bin/env sh

set -eu

REPOSITORY_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    printf '%s\n' '[pre-push] status=failed reason=not-a-git-worktree' >&2
    exit 1
}

# Publishing an identity cannot be undone (forks, pull request refs and
# scrapers keep it), so this check runs before the skip switch below and is
# never skipped. git hands the hook one line per pushed ref on stdin.
printf '%s\n' "[pre-push] status=start check=commit-identity root=${REPOSITORY_ROOT}"
if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- commit-identity --pre-push; then
    printf '%s\n' "[pre-push] status=success check=commit-identity"
else
    printf '%s\n' "[pre-push] status=failed check=commit-identity" >&2
    exit 1
fi

# Every push triggers a paid GitHub Actions round trip; a compile failure that
# one local `cargo verify` compile would have caught wastes that money and
# several minutes of wall clock. Gate the push on the full workspace compile
# across all targets. ASTRONOMICAL_SKIP_PRE_PUSH=1 escapes deliberately, for
# example when pushing a branch whose failures are the subject under test.
if [ "${ASTRONOMICAL_SKIP_PRE_PUSH:-0}" = "1" ]; then
    printf '%s\n' '[pre-push] status=skipped reason=ASTRONOMICAL_SKIP_PRE_PUSH=1'
    exit 0
fi

# The pre-commit ratchet judges each commit against its own HEAD, so two
# branches that pass on their own can still grow a function once both land
# (#2000 and #2001 did exactly that). Judging the pushed tree against the
# baseline on origin/main catches a branch built on an older baseline before
# it costs a pull request; run `git fetch origin main` first so that ref is
# current. A clone without origin/main skips the check rather than guess.
if git rev-parse --verify --quiet origin/main >/dev/null; then
    printf '%s\n' "[pre-push] status=start check=crap-complexity-against-main"
    if cargo run --quiet --manifest-path "${REPOSITORY_ROOT}/xtask/Cargo.toml" -p xtask -- crap-baseline --against origin/main; then
        printf '%s\n' "[pre-push] status=success check=crap-complexity-against-main"
    else
        printf '%s\n' "[pre-push] status=failed check=crap-complexity-against-main" >&2
        printf '%s\n' '[pre-push] hint=merge origin/main into this branch, then bring each grown function back under its main baseline score' >&2
        exit 1
    fi
else
    printf '%s\n' '[pre-push] status=skipped check=crap-complexity-against-main reason=no-origin-main'
fi

printf '%s\n' "[pre-push] status=start check=cargo-verify root=${REPOSITORY_ROOT}"
started_epoch_seconds="$(date +%s)"
if (cd "${REPOSITORY_ROOT}" && cargo verify); then
    elapsed_seconds=$(( $(date +%s) - started_epoch_seconds ))
    printf '%s\n' "[pre-push] status=success check=cargo-verify elapsed_seconds=${elapsed_seconds}"
else
    elapsed_seconds=$(( $(date +%s) - started_epoch_seconds ))
    printf '%s\n' "[pre-push] status=failed check=cargo-verify elapsed_seconds=${elapsed_seconds}" >&2
    # Not every failure here is a compile error: a build that rebuilds MLX
    # from source (any change to the native build identity, such as a cc
    # bump) fails before compiling when this Mac's native-dependency cache
    # was never provisioned, so the hint names that case next to compile
    # errors instead of sending people to hunt for code errors.
    printf '%s\n' '[pre-push] hint=fix the errors above locally before spending a GitHub Actions run' >&2
    printf '%s\n' '[pre-push] hint=a "Missing ... archive" error means the native-dependency cache is empty; run cargo xtask bootstrap-native-dependencies' >&2
    exit 1
fi

# Rust dependency notices freshness is CI-owned: ci.yml regenerates the file
# in place for bot and default-branch builds and enforces the strict contract
# on human pull requests, where only a real notices-text difference fails.
# Keeping the check out of this hook means a push never requires the pinned
# cargo-about locally and never inspects uncommitted manifest edits from the
# dirty working tree.
