*.zip
*.crate

# Thin Talk web client toolchain local state
apps/thin-talk/web/node_modules/
apps/thin-talk/web/.test-build/

# OpenCode plugin toolchain local state (its dist/ is ignored above)
integrations/opencode/node_modules/

# Thin Talk web client bundles are generated by apps/thin-talk/web/build-web.mjs
apps/thin-talk/Sources/ThinTalkCanvas/Resources/web/bundle.js
