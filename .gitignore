# macOS filesystem metadata
.DS_Store
.AppleDouble
.LSOverride
._*

# Claude Code's per-machine folders. Only the shared parts of .claude are
# committed (settings.json, launch.json, skills); plans and worktrees are
# made on each Mac, and a worktree is a whole checkout of the repository.
# A local exclude used to keep them out on one Mac only, so any other clone
# could commit them.
/.claude/plans/
/.claude/worktrees/
/.claude/settings.local.json

# Editor and IDE local state
.idea/
.vscode/
*.swp
*.swo
*~

# Agent harness local state
AGENTS.override.md

private/

# Local UI screenshot captures
ScreenShots/

# Browser-control harness local state (snapshots captured by playwright-cli)
.playwright-cli/

# Local environment and machine-specific configuration
.env
.env.*
!.env.example
*.local

# Logs and temporary files
*.log
*.tmp
*.temp
.cache/
tmp/
temp/
.tmp-*.txt
.tmp-*.diff

# Python bytecode
__pycache__/
*.py[cod]

# Rust / Cargo
target/
/debug/
/release/
*.rs.bk
*.profraw
*.profdata

# Swift Package Manager
.build/

# Native build directories
build/
out/
dist/
cmake-build-*/
DerivedData/

# CMake and generated build-system files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
Testing/

# Ninja build metadata
.ninja_deps
.ninja_log
build.ninja
rules.ninja

