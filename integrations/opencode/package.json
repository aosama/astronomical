{
  "name": "opencode-astronomical",
  "version": "0.1.0",
  "description": "OpenCode plugin that lists the chat models of Astronomical, the local model runner for Apple silicon Macs, in OpenCode's model picker and keeps the list current while the app runs.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.ts"
  },
  "files": [
    "src",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs tests/component/*.test.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.mjs\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.mjs\" \"*.md\"",
    "verify": "npm run format:check && npm run typecheck && npm test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "astronomical",
    "provider",
    "local-llm",
    "openai-compatible"
  ],
  "license": "Apache-2.0",
  "homepage": "https://getastronomical.com/local-api.html",
  "bugs": {
    "url": "https://github.com/aosama/astronomical/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aosama/astronomical.git",
    "directory": "integrations/opencode"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.3.2",
    "@types/node": "^22.0.0",
    "prettier": "^3.8.1",
    "solid-js": "^1.9.12",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.3.0 <3"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
