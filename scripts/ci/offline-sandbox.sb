;; The macOS counterpart of the Linux offline-sandbox job (issue #1333): the
;; whole offline lane runs with real networking denied while file access,
;; process execution, and the offline contract's sanctioned local
;; communication stay allowed. sandbox-exec is deprecated by Apple but
;; remains the only runner-level mechanism on hosted macOS; this profile is
;; repository-owned so any loosening is reviewable in diffs.
;;
;; The offline property (see the lane vocabulary in .cargo/config.toml) is
;; "no real network beyond localhost". Loopback TCP/UDP and Unix Domain
;; Sockets — the daemon's local inter-process communication surface, which is
;; filesystem-local rather than network — are inside that contract, so a
;; proof that denies them would be stricter than the contract it verifies and
;; would fail conforming tests (the stub daemons of the offline journeys
;; could not bind their sockets).
(version 1)
(allow default)
(deny network*)
;; Re-allow the contract's local communication after the blanket denial: in
;; Sandbox Profile Language the last matching rule wins, so these filtered
;; allows override (deny network*) for loopback and Unix Domain Socket
;; operations only. The forms follow the system's own profiles: binding on
;; any local address is not reachability (outbound stays the gated side),
;; port 0 in a network address is the wildcard port, and Unix Domain Socket
;; operations carry their own filters. Reaching any non-loopback address
;; stays denied.
(allow network-bind (local ip))
(allow network-outbound (remote ip "localhost:*"))
(allow network-inbound)
(allow network* (local unix-socket))
(allow network* (remote unix-socket))
