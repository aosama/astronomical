+  const size_t allowance_bytes =
+      configured_limit_bytes / astronomical_transient_allowance_divisor;
+  if (configured_limit_bytes >
+      std::numeric_limits<size_t>::max() - allowance_bytes) {
+    return std::numeric_limits<size_t>::max();
+  }
