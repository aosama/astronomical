+void CommandEncoder::register_indirect_input_array(const array& a) {
+  if (all_inputs_.insert(a.buffer().ptr()).second) {
+    buffer_sizes_ += a.data_size();
+  }
+  auto resource =
+      static_cast<MTL::Resource*>(const_cast<void*>(a.buffer().ptr()));
+  next_inputs_.insert(resource);
+  needs_barrier_ =
+      needs_barrier_ | (prev_outputs_.find(resource) != prev_outputs_.end());
+  // Indirect argument-buffer references are not visible through setBuffer.
+  // Explicit usage makes non-wired MLX allocations available to this dispatch.
+  get_command_encoder()->useResource(resource, MTL::ResourceUsageRead);
+}
