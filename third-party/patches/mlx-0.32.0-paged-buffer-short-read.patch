+
+TEST_CASE("test direct paged buffer read rejects a short source range") {
+  const std::string file_path = get_temp_file("test_paged_buffer_short_source.bin");
+  const std::array<uint32_t, 3> source_values = {11, 22, 33};
+  {
+    std::ofstream source_file(file_path, std::ios::binary);
+    source_file.write(
+        reinterpret_cast<const char*>(source_values.data()),
+        source_values.size() * sizeof(uint32_t));
+  }
+  auto source_reader = std::make_shared<io::ParallelFileReader>(file_path);
+  auto destination_slot =
+      std::make_shared<PagedBufferSlot>(4 * sizeof(uint32_t));
+  CHECK_THROWS_AS(
+      read_paged_buffer_ranges({PagedBufferReadRange{
+          source_reader,
+          0,
+          destination_slot,
+          0,
+          4 * sizeof(uint32_t)}}),
+      std::runtime_error);
+}
