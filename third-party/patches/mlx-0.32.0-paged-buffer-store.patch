+#include <array>
 #include <filesystem>
 #include <fstream>
 #include <stdexcept>
@@ -8,6 +9,7 @@
 #include "doctest/doctest.h"
 
 #include "mlx/mlx.h"
+#include "mlx/paged_buffer_store.h"
 
 using namespace mlx::core;
 
@@ -342,3 +344,39 @@ TEST_CASE("test single array serialization") {
     CHECK(array_equal(a, b).item<bool>());
   }
 }
+
+TEST_CASE("test direct positional reads into a paged MLX buffer") {
+  const std::string file_path = get_temp_file("test_paged_buffer_source.bin");
+  const std::array<uint32_t, 4> source_values = {11, 22, 33, 44};
+  {
+    std::ofstream source_file(file_path, std::ios::binary);
+    source_file.write(
+        reinterpret_cast<const char*>(source_values.data()),
+        source_values.size() * sizeof(uint32_t));
+  }
+  auto destination_slot =
+      std::make_shared<PagedBufferSlot>(source_values.size() * sizeof(uint32_t));
+  auto source_reader = std::make_shared<io::ParallelFileReader>(file_path);
+  read_paged_buffer_ranges({
+      PagedBufferReadRange{
+          source_reader,
+          2 * sizeof(uint32_t),
+          destination_slot,
+          0,
+          2 * sizeof(uint32_t)},
+      PagedBufferReadRange{
+          source_reader,
+          0,
+          destination_slot,
+          2 * sizeof(uint32_t),
+          2 * sizeof(uint32_t)},
+  });
+  destination_slot->commit();
+  auto reordered_values = destination_slot->view(
+      {4}, uint32, 0, source_values.size() * sizeof(uint32_t));
+  CHECK_EQ(reordered_values.data<uint32_t>()[0], 33);
+  CHECK_EQ(reordered_values.data<uint32_t>()[1], 44);
+  CHECK_EQ(reordered_values.data<uint32_t>()[2], 11);
+  CHECK_EQ(reordered_values.data<uint32_t>()[3], 22);
+  CHECK_THROWS_AS(destination_slot->writable_data(), std::runtime_error);
+}
