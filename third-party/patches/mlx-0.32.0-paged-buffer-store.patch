diff --git a/mlx/paged_buffer_store.h b/mlx/paged_buffer_store.h
new file mode 100644
index 0000000..c9ed0aa
--- /dev/null
+++ b/mlx/paged_buffer_store.h
@@ -0,0 +1,49 @@
+// Copyright © 2026 Astronomical contributors
+
+#pragma once
+
+#include <memory>
+#include <vector>
+
+#include "mlx/api.h"
+#include "mlx/array.h"
+#include "mlx/io/load.h"
+
+namespace mlx::core {
+
+/** One allocator-owned shared buffer reserved for direct positional loading. */
+class MLX_API PagedBufferSlot {
+ public:
+  explicit PagedBufferSlot(size_t byte_count);
+
+  size_t byte_count() const;
+  uint8_t* writable_data();
+  void commit();
+  bool is_committed() const;
+
+  array view(
+      Shape shape,
+      Dtype dtype,
+      size_t byte_offset,
+      size_t byte_count) const;
+
+  const array& storage() const;
+
+ private:
+  array storage_;
+  bool is_committed_{false};
+};
+
+struct MLX_API PagedBufferReadRange {
+  std::shared_ptr<io::Reader> reader;
+  uint64_t source_offset;
+  std::shared_ptr<PagedBufferSlot> destination_slot;
+  size_t destination_offset;
+  size_t byte_count;
+};
+
+/** Reads disjoint positional ranges directly into uncommitted MLX slots. */
+MLX_API void read_paged_buffer_ranges(
+    const std::vector<PagedBufferReadRange>& read_ranges);
+
+} // namespace mlx::core
diff --git a/mlx/paged_buffer_store.cpp b/mlx/paged_buffer_store.cpp
new file mode 100644
index 0000000..5bcfb56
--- /dev/null
+++ b/mlx/paged_buffer_store.cpp
@@ -0,0 +1,173 @@
+// Copyright © 2026 Astronomical contributors
+
+#include "mlx/paged_buffer_store.h"
+
+#include <algorithm>
+#include <climits>
+#include <future>
+#include <limits>
+#include <stdexcept>
+
+#include "mlx/allocator.h"
+
+namespace mlx::core {
+
+namespace {
+
+Shape validated_slot_shape(size_t byte_count) {
+  if (byte_count == 0 || byte_count > static_cast<size_t>(INT_MAX)) {
+    throw std::invalid_argument(
+        "paged buffer slot byte count must fit the MLX shape range");
+  }
+  return {static_cast<int>(byte_count)};
+}
+
+size_t shape_element_count(const Shape& shape) {
+  size_t element_count = 1;
+  for (const auto dimension : shape) {
+    if (dimension <= 0 ||
+        element_count >
+            std::numeric_limits<size_t>::max() /
+                static_cast<size_t>(dimension)) {
+      throw std::invalid_argument("paged buffer view has an invalid shape");
+    }
+    element_count *= static_cast<size_t>(dimension);
+  }
+  return element_count;
+}
+
+Strides row_contiguous_strides(const Shape& shape) {
+  Strides strides(shape.size(), 1);
+  size_t running_stride = 1;
+  for (size_t reverse_dimension = 0; reverse_dimension < shape.size();
+       ++reverse_dimension) {
+    const size_t dimension_index = shape.size() - reverse_dimension - 1;
+    strides[dimension_index] = static_cast<int64_t>(running_stride);
+    running_stride *= static_cast<size_t>(shape[dimension_index]);
+  }
+  return strides;
+}
+
+} // namespace
+
+PagedBufferSlot::PagedBufferSlot(size_t byte_count)
+    : storage_(validated_slot_shape(byte_count), uint8, nullptr, {}) {
+  storage_.set_data(allocator::malloc(byte_count));
+}
+
+size_t PagedBufferSlot::byte_count() const {
+  return storage_.size();
+}
+
+uint8_t* PagedBufferSlot::writable_data() {
+  if (is_committed_) {
+    throw std::runtime_error("a committed paged buffer slot is immutable");
+  }
+  return storage_.data<uint8_t>();
+}
+
+void PagedBufferSlot::commit() {
+  is_committed_ = true;
+}
+
+bool PagedBufferSlot::is_committed() const {
+  return is_committed_;
+}
+
+array PagedBufferSlot::view(
+    Shape shape,
+    Dtype dtype,
+    size_t byte_offset,
+    size_t byte_count) const {
+  if (!is_committed_) {
+    throw std::runtime_error(
+        "paged buffer views require a committed destination slot");
+  }
+  const size_t element_count = shape_element_count(shape);
+  if (dtype.size() == 0 || byte_offset % dtype.size() != 0 ||
+      element_count > std::numeric_limits<size_t>::max() / dtype.size() ||
+      element_count * dtype.size() != byte_count ||
+      byte_offset > storage_.size() ||
+      byte_count > storage_.size() - byte_offset) {
+    throw std::invalid_argument(
+        "paged buffer view exceeds its slot or is dtype misaligned");
+  }
+  const auto maximum_dimension =
+      *std::max_element(shape.begin(), shape.end());
+  array typed_view(shape, dtype, nullptr, {});
+  typed_view.copy_shared_buffer(
+      storage_,
+      row_contiguous_strides(shape),
+      array::Flags{
+          true,
+          true,
+          element_count <= static_cast<size_t>(maximum_dimension)},
+      element_count,
+      static_cast<int64_t>(byte_offset / dtype.size()));
+  return typed_view;
+}
+
+const array& PagedBufferSlot::storage() const {
+  return storage_;
+}
+
+void read_paged_buffer_ranges(
+    const std::vector<PagedBufferReadRange>& read_ranges) {
+  for (const auto& read_range : read_ranges) {
+    if (!read_range.reader || !read_range.destination_slot ||
+        read_range.destination_slot->is_committed() ||
+        read_range.byte_count == 0 ||
+        read_range.destination_offset >
+            read_range.destination_slot->byte_count() ||
+        read_range.byte_count >
+            read_range.destination_slot->byte_count() -
+                read_range.destination_offset) {
+      throw std::invalid_argument("paged buffer read range is invalid");
+    }
+  }
+  for (size_t left_index = 0; left_index < read_ranges.size(); ++left_index) {
+    for (size_t right_index = left_index + 1; right_index < read_ranges.size();
+         ++right_index) {
+      const auto& left_range = read_ranges[left_index];
+      const auto& right_range = read_ranges[right_index];
+      if (left_range.destination_slot == right_range.destination_slot &&
+          left_range.destination_offset <
+              right_range.destination_offset + right_range.byte_count &&
+          right_range.destination_offset <
+              left_range.destination_offset + left_range.byte_count) {
+        throw std::invalid_argument(
+            "paged buffer destination ranges must not overlap");
+      }
+    }
+  }
+  std::vector<std::shared_future<void>> read_futures;
+  read_futures.reserve(read_ranges.size());
+  for (const auto& read_range : read_ranges) {
+    read_futures.push_back(
+        io::thread_pool()
+            .enqueue([read_range]() {
+              read_range.reader->read(
+                  reinterpret_cast<char*>(
+                      read_range.destination_slot->writable_data() +
+                      read_range.destination_offset),
+                  read_range.byte_count,
+                  read_range.source_offset);
+            })
+            .share());
+  }
+  std::exception_ptr first_read_failure;
+  for (auto& read_future : read_futures) {
+    try {
+      read_future.get();
+    } catch (...) {
+      if (!first_read_failure) {
+        first_read_failure = std::current_exception();
+      }
+    }
+  }
+  if (first_read_failure) {
+    std::rethrow_exception(first_read_failure);
+  }
+}
+
+} // namespace mlx::core
