--- a/mlx/io/safetensors.cpp
+++ b/mlx/io/safetensors.cpp
@@ -1,5 +1,6 @@
 // Copyright © 2023 Apple Inc.

+#include <algorithm>
 #include <json.hpp>
 #include <memory>
 #include <sstream>
@@ -239,37 +240,47 @@ void save_safetensors(
   parent["__metadata__"] = _metadata;

-  {
-    std::vector<array> to_eval;
-    to_eval.reserve(a.size());
-    for (auto& p : a) {
-      p.second = contiguous(p.second);
-      to_eval.push_back(p.second);
-    }
-    eval(std::move(to_eval));
-  }
+  // Fix payload order before evaluation. Writing the largest tensors first lets
+  // the allocator reuse one released contiguous materialization for subsequent
+  // smaller tensors while the name tie-breaker keeps the file deterministic.
+  std::vector<std::pair<std::string, array>> ordered_arrays;
+  ordered_arrays.reserve(a.size());
+  for (const auto& [key, arr] : a) {
+    ordered_arrays.emplace_back(key, arr);
+  }
+  std::sort(
+      ordered_arrays.begin(),
+      ordered_arrays.end(),
+      [](const auto& left, const auto& right) {
+        if (left.second.nbytes() != right.second.nbytes()) {
+          return left.second.nbytes() > right.second.nbytes();
+        }
+        return left.first < right.first;
+      });

   size_t offset = 0;
-  for (auto& [key, arr] : a) {
+  for (const auto& [key, arr] : ordered_arrays) {
     if (arr.nbytes() == 0) {
       std::ostringstream msg;
       msg << "[save_safetensors] Cannot serialize an empty array ('" << key
           << "')";
       throw std::invalid_argument(msg.str());
     }

     json child;
     child["dtype"] = dtype_to_safetensor_str(arr.dtype());
     child["shape"] = arr.shape();
     child["data_offsets"] = std::vector<size_t>{offset, offset + arr.nbytes()};
     parent[key] = child;
     offset += arr.nbytes();
   }

   auto header = parent.dump();
   uint64_t header_len = header.length();
   out_stream->write(reinterpret_cast<char*>(&header_len), 8);
   out_stream->write(header.c_str(), header_len);
-  for (auto& [key, arr] : a) {
-    out_stream->write(arr.data<char>(), arr.nbytes());
+  for (const auto& [key, arr] : ordered_arrays) {
+    auto contiguous_array = contiguous(arr);
+    eval(contiguous_array);
+    out_stream->write(contiguous_array.data<char>(), contiguous_array.nbytes());
   }
 }
