+constexpr size_t astronomical_transient_allowance_divisor = 100;
+constexpr const char* astronomical_active_memory_limit_error_marker =
+    "ASTRONOMICAL_MLX_ACTIVE_MEMORY_LIMIT_EXCEEDED";
+
+size_t astronomical_allowed_active_memory_bytes(size_t configured_limit_bytes) {
+  const size_t allowance_bytes =
+      configured_limit_bytes / astronomical_transient_allowance_divisor;
+  if (configured_limit_bytes >
+      std::numeric_limits<size_t>::max() - allowance_bytes) {
+    return std::numeric_limits<size_t>::max();
+  }
+  return configured_limit_bytes + allowance_bytes;
+}
+
+bool astronomical_allocation_exceeds_limit(
+    size_t active_memory_bytes,
+    size_t allocation_bytes,
+    size_t allowed_active_memory_bytes) {
+  return active_memory_bytes > allowed_active_memory_bytes ||
+      allocation_bytes > allowed_active_memory_bytes - active_memory_bytes;
+}
+
+std::runtime_error astronomical_active_memory_limit_error(
+    size_t active_memory_bytes,
+    size_t allocation_bytes,
+    size_t allowed_active_memory_bytes) {
+  std::ostringstream message;
+  message << astronomical_active_memory_limit_error_marker
+          << " active_bytes=" << active_memory_bytes
+          << " allocation_bytes=" << allocation_bytes
+          << " allowed_bytes=" << allowed_active_memory_bytes;
+  return std::runtime_error(message.str());
+}
+
