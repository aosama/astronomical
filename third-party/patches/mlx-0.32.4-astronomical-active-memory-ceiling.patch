-  gc_limit_ = std::min(
-      block_limit_,
-      static_cast<size_t>(0.95 * device_->recommendedMaxWorkingSetSize()));
+  // Stock MLX starts releasing cached buffers at 95% of Metal's recommended
+  // working set whatever limit the caller set. Astronomical sets the limit
+  // a person chose, up to 97.5% of that working set, and enforces active
+  // memory against it, so a 95% line drains the cache on every allocation
+  // once a model fills its share and nothing is reused. Measured on a 48 GB
+  // Mac: a 122B model replied at 10 to 11 tokens per second above the 95%
+  // line and 28 to 30 below it. The line follows the limit instead, never
+  // above the recommended working set. Peak memory does not rise: cached
+  // buffers are still released once active plus cached memory reaches the
+  // line, and active memory keeps its own enforced ceiling. Limits below the
+  // 95% line behave exactly as upstream.
+  gc_limit_ = std::min(
+      block_limit_,
+      static_cast<size_t>(device_->recommendedMaxWorkingSetSize()));
   return limit;
 };
 
