diff --git a/mlx/transforms.h b/mlx/transforms.h
--- a/mlx/transforms.h
+++ b/mlx/transforms.h
@@ -9,6 +9,22 @@
 
 namespace mlx::core {
 
+// Astronomical: how often work was handed between the caller, the GPU and
+// the CPU stream since the process started. Every one is a wait somewhere,
+// and a reply token's speed depends on how many it makes, so the engine
+// reports the counts beside its timings instead of inferring them.
+struct EvaluationCounts {
+  // Evaluations that walked a graph and waited for it.
+  uint64_t blocking_evaluations;
+  // Evaluations that walked a graph and returned without waiting.
+  uint64_t asynchronous_evaluations;
+  // Waits for arrays an earlier evaluation had already been handed.
+  uint64_t waits_for_submitted_arrays;
+  // Times one stream waited inside an evaluation for another's output.
+  uint64_t cross_stream_waits;
+};
+MLX_API EvaluationCounts evaluation_counts();
+
 MLX_API void async_eval(std::vector<array> outputs);
 
