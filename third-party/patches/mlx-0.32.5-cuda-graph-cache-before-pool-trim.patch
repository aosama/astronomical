+// Graph executables cached before a clear_cache must not be launched after
+// it: with CUDA graphs on, a launch after clear_cache (which trims the memory
+// pool with cudaMemPoolTrimTo) crashed inside cudaGraphLaunch, and dropping
+// the cached executables first avoided it. clear_cache bumps this
+// generation; each encoder drops its graph_cache_ at its next commit once
+// the generation has moved, on whichever thread owns it.
+//
+// The generation each encoder last saw is kept in a table here rather than
+// as an encoder member, so this change stays out of device.h, which nearly
+// every CUDA unit includes.
+std::atomic<uint64_t>& graph_cache_generation() {
+  static std::atomic<uint64_t> generation{0};
+  return generation;
+}
+
+// Whether `encoder`'s graph_cache_ predates the last clear_cache; records
+// that it is current from now on.
+bool take_stale_graph_cache(const CommandEncoder* encoder) {
+  static std::mutex mutex;
+  static auto* seen_generations =
+      new std::unordered_map<const CommandEncoder*, uint64_t>();
+  auto current_generation = graph_cache_generation().load();
+  std::lock_guard lock(mutex);
+  auto& seen_generation = (*seen_generations)[encoder];
+  if (seen_generation == current_generation) {
+    return false;
+  }
+  seen_generation = current_generation;
+  return true;
+}
