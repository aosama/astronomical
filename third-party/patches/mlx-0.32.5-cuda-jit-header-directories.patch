+/* Name the folders MLX's run-time CUDA compiler (NVRTC) reads headers from,
+ * for a program that links MLX statically and so has no `include/` folder
+ * beside the binary MLX is in: `bundled_headers_directory` holds the CUTLASS
+ * and CuTe headers MLX installs (with CCCL's in its `cccl/` subfolder), and
+ * `cuda_toolkit_include_directory` the CUDA runtime headers. An empty string
+ * keeps MLX's own search for that folder. Call it before the first
+ * evaluation that compiles a kernel; later calls have no effect. A no-op in
+ * a build without the CUDA backend. (Astronomical patch.) */
+MLX_API void set_jit_header_directories(
+    const std::string& bundled_headers_directory,
+    const std::string& cuda_toolkit_include_directory);
+
 /* Get information about a CUDA device. */
 MLX_API const
     std::unordered_map<std::string, std::variant<std::string, size_t>>&
