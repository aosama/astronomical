+// The folders named through set_jit_header_directories, read once by
+// include_path_args. Empty means MLX's own search.
+struct JitHeaderDirectories {
+  std::string bundled_headers_directory;
+  std::string cuda_toolkit_include_directory;
+};
+
+JitHeaderDirectories& configured_jit_header_directories() {
+  static JitHeaderDirectories directories;
+  return directories;
+}
+
 // Return the --include-path args used for invoking NVRTC.
 const std::vector<std::string>& include_path_args() {
   static std::vector<std::string> cached_args = []() {
     std::vector<std::string> args;
+    const JitHeaderDirectories& configured = configured_jit_header_directories();
     // Add path to bundled headers.
     auto root_dir = current_binary_dir();
 #if !defined(_WIN32)
     root_dir = root_dir.parent_path();
 #endif
-    auto path = root_dir / "include";
+    auto path = configured.bundled_headers_directory.empty()
+        ? root_dir / "include"
+        : std::filesystem::path(configured.bundled_headers_directory);
     if (std::filesystem::exists(path)) {
       args.push_back(fmt::format("--include-path={}", path.string()));
     }
@@ -83,9 +99,11 @@ const std::vector<std::string>& include_path_args() {
     if (std::filesystem::exists(path)) {
       args.push_back(fmt::format("--include-path={}", path.string()));
     }
-    // Add path to CUDA runtime headers, try local-installed python package
-    // first and then system-installed headers.
-    path = root_dir.parent_path() / "nvidia" / cudart_dirname() / "include";
+    // Add path to CUDA runtime headers: the configured folder, then a
+    // local-installed python package, then system-installed headers.
+    path = configured.cuda_toolkit_include_directory.empty()
+        ? root_dir.parent_path() / "nvidia" / cudart_dirname() / "include"
+        : std::filesystem::path(configured.cuda_toolkit_include_directory);
     if (!std::filesystem::exists(path)) {
       const char* home = std::getenv("CUDA_HOME");
       if (!home) {
@@ -499,4 +517,11 @@ JitModule& get_jit_module(
   return it->second;
 }
 
+void set_jit_header_directories(
+    const std::string& bundled_headers_directory,
+    const std::string& cuda_toolkit_include_directory) {
+  configured_jit_header_directories() = {
+      bundled_headers_directory, cuda_toolkit_include_directory};
+}
