+void record_completed_gpu_command_buffer(uint64_t busy_nanoseconds) {
+  gpu_command_buffer_count.fetch_add(1, std::memory_order_relaxed);
+  gpu_busy_nanosecond_count.fetch_add(
+      busy_nanoseconds, std::memory_order_relaxed);
