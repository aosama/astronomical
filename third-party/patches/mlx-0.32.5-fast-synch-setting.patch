diff --git a/mlx/backend/metal/fence.cpp b/mlx/backend/metal/fence.cpp
--- a/mlx/backend/metal/fence.cpp
+++ b/mlx/backend/metal/fence.cpp
@@ -131,8 +131,21 @@
   compute_encoder.set_bytes(f.count, 1);
   compute_encoder.dispatch_threads(kernel_dims, kernel_dims);
 
+  // Astronomical: a command buffer that fails never runs the kernel above,
+  // and a CPU stream waiting on this value would then spin forever. Publish
+  // the value from the completion handler instead, so the wait ends and the
+  // evaluation reports the command buffer's error.
   compute_encoder.get_command_buffer()->addCompletedHandler(
-      [fence_ = fence_](MTL::CommandBuffer* cbuf) {});
+      [fence_ = fence_, count = f.count](MTL::CommandBuffer* cbuf) {
+        if (cbuf->status() != MTL::CommandBufferStatusError) {
+          return;
+        }
+        auto& f = *static_cast<FenceImpl*>(fence_.get());
+        uint32_t published = f.cpu_value()[0].load();
+        while (published < count &&
+               !f.cpu_value()[0].compare_exchange_weak(published, count)) {
+        }
+      });
   return f.count;
 }
 
