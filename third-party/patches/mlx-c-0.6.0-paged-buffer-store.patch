+/* Copyright © 2023-2026 Apple Inc. */
+
+#ifndef MLX_PAGED_BUFFER_STORE_H
+#define MLX_PAGED_BUFFER_STORE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "mlx/c/array.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct mlx_paged_buffer_slot_ {
+  void* ctx;
+} mlx_paged_buffer_slot;
+
+typedef struct mlx_paged_file_reader_ {
+  void* ctx;
+} mlx_paged_file_reader;
+
+typedef struct mlx_paged_buffer_read_range_ {
+  mlx_paged_file_reader source_reader;
+  uint64_t source_offset;
+  mlx_paged_buffer_slot destination_slot;
+  size_t destination_offset;
+  size_t byte_count;
+} mlx_paged_buffer_read_range;
+
+int mlx_paged_buffer_slot_new(
+    mlx_paged_buffer_slot* output_slot,
+    size_t byte_count);
+int mlx_paged_buffer_slot_commit(mlx_paged_buffer_slot slot);
+int mlx_paged_buffer_slot_is_committed(
+    bool* output_is_committed,
+    mlx_paged_buffer_slot slot);
+int mlx_paged_buffer_slot_view(
+    mlx_array* output,
+    mlx_paged_buffer_slot slot,
+    const int* shape,
+    size_t dimension_count,
+    mlx_dtype dtype,
+    size_t byte_offset,
+    size_t byte_count);
+int mlx_paged_buffer_slot_free(mlx_paged_buffer_slot slot);
+
+int mlx_paged_file_reader_new(
+    mlx_paged_file_reader* output_reader,
+    const char* source_file_path);
+int mlx_paged_file_reader_free(mlx_paged_file_reader reader);
+
+int mlx_read_paged_buffer_ranges(
+    const mlx_paged_buffer_read_range* read_ranges,
+    size_t read_range_count);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/mlx/c/paged_buffer_store.cpp b/mlx/c/paged_buffer_store.cpp
new file mode 100644
index 0000000..7ea0a91
--- /dev/null
+++ b/mlx/c/paged_buffer_store.cpp
@@ -0,0 +1,165 @@
+/* Copyright © 2023-2026 Apple Inc. */
+
+#include "mlx/c/paged_buffer_store.h"
+
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "mlx/c/error.h"
+#include "mlx/c/private/array.h"
+#include "mlx/c/private/enums.h"
+#include "mlx/paged_buffer_store.h"
+
+namespace {
+
+struct PagedBufferSlotHolder {
+  std::shared_ptr<mlx::core::PagedBufferSlot> slot;
+};
+
+struct PagedFileReaderHolder {
+  std::shared_ptr<mlx::core::io::ParallelFileReader> reader;
+};
+
+std::shared_ptr<mlx::core::PagedBufferSlot> slot_from_handle(
+    mlx_paged_buffer_slot slot) {
+  if (slot.ctx == nullptr) {
+    throw std::invalid_argument("expected a non-empty paged buffer slot");
+  }
+  return static_cast<PagedBufferSlotHolder*>(slot.ctx)->slot;
+}
+
+std::shared_ptr<mlx::core::io::ParallelFileReader> reader_from_handle(
+    mlx_paged_file_reader reader) {
+  if (reader.ctx == nullptr) {
+    throw std::invalid_argument("expected a non-empty paged file reader");
+  }
+  return static_cast<PagedFileReaderHolder*>(reader.ctx)->reader;
+}
+
+}  // namespace
+
+extern "C" int mlx_paged_buffer_slot_new(
+    mlx_paged_buffer_slot* output_slot,
+    size_t byte_count) {
+  try {
+    if (output_slot == nullptr) {
+      throw std::invalid_argument("paged buffer slot output is missing");
+    }
+    output_slot->ctx = new PagedBufferSlotHolder{
+        std::make_shared<mlx::core::PagedBufferSlot>(byte_count)};
+    return 0;
+  } catch (const std::exception& error) {
+    mlx_error(error.what());
+    return 1;
+  }
+}
+
+extern "C" int mlx_paged_buffer_slot_commit(mlx_paged_buffer_slot slot) {
+  try {
+    slot_from_handle(slot)->commit();
+    return 0;
+  } catch (const std::exception& error) {
+    mlx_error(error.what());
+    return 1;
+  }
+}
+
+extern "C" int mlx_paged_buffer_slot_is_committed(
+    bool* output_is_committed,
+    mlx_paged_buffer_slot slot) {
+  try {
+    if (output_is_committed == nullptr) {
+      throw std::invalid_argument("paged buffer committed output is missing");
+    }
+    *output_is_committed = slot_from_handle(slot)->is_committed();
+    return 0;
+  } catch (const std::exception& error) {
+    mlx_error(error.what());
+    return 1;
+  }
+}
+
+extern "C" int mlx_paged_buffer_slot_view(
+    mlx_array* output,
+    mlx_paged_buffer_slot slot,
+    const int* shape,
+    size_t dimension_count,
+    mlx_dtype dtype,
+    size_t byte_offset,
+    size_t byte_count) {
+  try {
+    if (output == nullptr || shape == nullptr || dimension_count == 0) {
+      throw std::invalid_argument("paged buffer view arguments are invalid");
+    }
+    mlx::core::Shape view_shape(shape, shape + dimension_count);
+    mlx_array_set_(
+        *output,
+        slot_from_handle(slot)->view(
+            view_shape,
+            mlx_dtype_to_cpp(dtype),
+            byte_offset,
+            byte_count));
+    return 0;
+  } catch (const std::exception& error) {
+    mlx_error(error.what());
+    return 1;
+  }
+}
+
+extern "C" int mlx_paged_buffer_slot_free(mlx_paged_buffer_slot slot) {
+  delete static_cast<PagedBufferSlotHolder*>(slot.ctx);
+  return 0;
+}
+
+extern "C" int mlx_paged_file_reader_new(
+    mlx_paged_file_reader* output_reader,
+    const char* source_file_path) {
+  try {
+    if (output_reader == nullptr || source_file_path == nullptr) {
+      throw std::invalid_argument("paged file reader arguments are invalid");
+    }
+    auto reader = std::make_shared<mlx::core::io::ParallelFileReader>(
+        std::string(source_file_path));
+    if (!reader->is_open() || !reader->good()) {
+      throw std::runtime_error("paged source file could not be opened");
+    }
+    output_reader->ctx = new PagedFileReaderHolder{std::move(reader)};
+    return 0;
+  } catch (const std::exception& error) {
+    mlx_error(error.what());
+    return 1;
+  }
+}
+
+extern "C" int mlx_paged_file_reader_free(mlx_paged_file_reader reader) {
+  delete static_cast<PagedFileReaderHolder*>(reader.ctx);
+  return 0;
+}
+
+extern "C" int mlx_read_paged_buffer_ranges(
+    const mlx_paged_buffer_read_range* read_ranges,
+    size_t read_range_count) {
+  try {
+    if (read_ranges == nullptr || read_range_count == 0) {
+      throw std::invalid_argument("paged buffer read ranges are missing");
+    }
+    std::vector<mlx::core::PagedBufferReadRange> cpp_read_ranges;
+    cpp_read_ranges.reserve(read_range_count);
+    for (size_t range_index = 0; range_index < read_range_count; ++range_index) {
+      const auto& read_range = read_ranges[range_index];
+      cpp_read_ranges.push_back(mlx::core::PagedBufferReadRange{
+          reader_from_handle(read_range.source_reader),
+          read_range.source_offset,
+          slot_from_handle(read_range.destination_slot),
+          read_range.destination_offset,
+          read_range.byte_count});
+    }
+    mlx::core::read_paged_buffer_ranges(cpp_read_ranges);
+    return 0;
+  } catch (const std::exception& error) {
+    mlx_error(error.what());
+    return 1;
+  }
+}
